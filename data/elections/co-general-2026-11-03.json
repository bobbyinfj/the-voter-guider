      "id": "co26-m-larimer-1a",
      "number": "1A",
      "title": "Larimer County sales and use tax for resilience, roads, parks and public safety",
      "level": "county",
      "type": "measure",
      "description": "Would create a 0.3% countywide sales and use tax (food for home, gasoline, diapers and prescriptions exempt), raising up to $34.5 million a year from 2027 for wildfire and watershed protection, natural-hazard resilience, roads, bridges, parks, trails, open space, emergency services and county facilities. Revenue audited annually and exempt from TABOR limits.",
      "sourceUrl": "https://www.larimer.gov/sites/default/files/2026ge-larimer-county-sample-ballot.pdf"
    },
