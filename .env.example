# PostgreSQL connection string (Neon, or a local Postgres 17)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require"

# Optional: email sign-in links (nodemailer). Without SMTP_URL, development prints links to the
# server log and production hides email sign-in. Gmail example (use an app password):
# SMTP_URL="smtps://you%40gmail.com:app-password@smtp.gmail.com:465"
# MAIL_FROM="The Voter Guider <you@gmail.com>"
# Base URL for links in emails (defaults to Vercel's production URL, then localhost)
# APP_URL="https://your-domain.example"
